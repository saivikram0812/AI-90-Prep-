# Postgres connection string.
# Free options: Neon (neon.tech), Supabase, or Railway's Postgres plugin.
DATABASE_URL=postgresql://user:password@host/dbname

# Port the service listens on. Most hosts set this for you.
PORT=8787

# Comma-separated origins allowed to call the API.
# Leave blank to allow all — safe here because auth is a bearer token, not a cookie.
ALLOWED_ORIGINS=https://YOURNAME.github.io,http://localhost:8931
